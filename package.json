{
  "name": "nexo",
  "private": true,
  "version": "0.0.0",
  "description": "Nexo — panel unico y suite de modulos internos de Materiales J Castillo (estilo Odoo)",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "node scripts/check-app-tasks.mjs build && turbo run build",
    "lint": "node scripts/check-app-tasks.mjs lint && turbo run lint",
    "lint:plan": "node scripts/lint-apps.mjs plan",
    "lint:gate": "node scripts/lint-apps.mjs gate",
    "lint:deuda": "node scripts/lint-apps.mjs deuda",
    "lint:self-test": "node scripts/lint-apps.mjs self-test",
    "typecheck": "node scripts/check-app-tasks.mjs typecheck && turbo run typecheck",
    "test:agencia:access": "node apps/agencia/scripts/check-access.cjs",
    "test:presupuesto": "pnpm --filter nexo-presupuesto test",
    "test:rrhh:p1": "node supabase/tests/run_rrhh_p1_pin_ambiguo.mjs",
    "test:db": "pnpm run test:rrhh:p1 && pnpm run test:rrhh:compartido && pnpm run test:rrhh:p2 && pnpm run test:rrhh:p3 && pnpm run test:rrhh:p4 && pnpm run test:rrhh:p5 && pnpm run test:rrhh:p6 && pnpm run test:rrhh:p7-catalogo-local && pnpm run test:rrhh:planilla-pl2a && pnpm run test:rrhh:planilla && pnpm run test:flotilla:e2",
    "test:flotilla:e2": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/flotilla_entorno.sql supabase/migrations/20261024140400_flotilla_e2_esquema.sql supabase/migrations/20261024140609_flotilla_e2_indices_fk.sql supabase/tests/flotilla_e2.prueba.sql",
    "verify": "pnpm run typecheck && pnpm run lint:gate && pnpm run lint:self-test && pnpm run test:db && pnpm run test:agencia:access && pnpm run test:presupuesto && pnpm run build",
    "test:rrhh:compartido": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261017131004_p1_pin_ambiguo_fallo_cerrado.sql supabase/tests/rrhh_p1_pin_ambiguo.prueba.sql",
    "test:rrhh:p2": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261017131004_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261017131040_rrhh_p2_pin_unico_empresa.sql supabase/tests/rrhh_p2_pin_unico.prueba.sql",
    "test:rrhh:p3": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261017131004_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261017131040_rrhh_p2_pin_unico_empresa.sql supabase/migrations/20261017131113_rrhh_p3_marca_contrato.sql supabase/tests/rrhh_p3_contrato.prueba.sql",
    "test:rrhh:p4": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261017131004_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261017131040_rrhh_p2_pin_unico_empresa.sql supabase/migrations/20261017131113_rrhh_p3_marca_contrato.sql supabase/migrations/20261017131132_rrhh_p4a_kiosko_solicitudes.sql supabase/migrations/20261017131202_rrhh_p4b_marca_atomica_idempotente.sql supabase/tests/rrhh_p4_secuencia_idempotencia.prueba.sql",
    "test:rrhh:p5": "node --experimental-strip-types --test supabase/tests/rrhh_p5_kiosk_flow.test.mjs",
    "test:rrhh:p6": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261017131004_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261017131040_rrhh_p2_pin_unico_empresa.sql supabase/migrations/20261017131113_rrhh_p3_marca_contrato.sql supabase/migrations/20261017131132_rrhh_p4a_kiosko_solicitudes.sql supabase/migrations/20261017131202_rrhh_p4b_marca_atomica_idempotente.sql supabase/migrations/20261017131221_rrhh_p6_consultar_marcas.sql supabase/tests/rrhh_p6_consultar_marcas.prueba.sql && node --experimental-strip-types --test supabase/tests/rrhh_p6_filtros.test.mjs supabase/tests/rrhh_reportes_formato.test.mjs",
    "test:rrhh:p7-catalogo-local": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261017131004_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261017131040_rrhh_p2_pin_unico_empresa.sql supabase/migrations/20261017131113_rrhh_p3_marca_contrato.sql supabase/migrations/20261017131132_rrhh_p4a_kiosko_solicitudes.sql supabase/migrations/20261017131202_rrhh_p4b_marca_atomica_idempotente.sql supabase/migrations/20261017131221_rrhh_p6_consultar_marcas.sql supabase/tests/rrhh_p7_remoto.sql && node --test supabase/tests/rrhh_p7_guard.test.mjs",
    "test:rrhh:planilla-pl2a": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_planilla_entorno.sql supabase/migrations/20261021191441_rrhh_planilla_pl2a_motor.sql supabase/tests/rrhh_planilla_pl2a.prueba.sql",
    "test:rrhh:planilla": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_planilla_entorno.sql supabase/migrations/20261021191441_rrhh_planilla_pl2a_motor.sql supabase/tests/rrhh_planilla_pl2b_entorno.sql supabase/tests/rrhh_planilla_pl2c_entorno.sql supabase/migrations/20261021235639_rrhh_planilla_pl2b_paso_cero.sql supabase/migrations/20261022000001_rrhh_planilla_pl2b_1_tablas.sql supabase/migrations/20261022000431_rrhh_planilla_pl2b_2_motor.sql supabase/migrations/20261022000640_rrhh_planilla_pl2b_3_liquidacion.sql supabase/migrations/20261022000939_rrhh_planilla_pl2b_4_rpc_vacaciones.sql supabase/migrations/20261022001314_rrhh_planilla_pl2b_5_prestamos_liquidaciones.sql supabase/migrations/20261022001530_rrhh_planilla_pl2c_1_lectura.sql supabase/migrations/20261022001727_rrhh_planilla_pl2c_2_configuracion.sql supabase/migrations/20261022001922_rrhh_planilla_pl2c_3_declaraciones_asistencia.sql supabase/migrations/20261022034035_rrhh_planilla_techo_inss_quincena.sql supabase/tests/rrhh_planilla_pl2a.prueba.sql supabase/tests/rrhh_planilla_pl2b.prueba.sql supabase/tests/rrhh_planilla_pl2c.prueba.sql"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "turbo": "^2.1.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "dompurify": "3.4.17"
    }
  }
}
