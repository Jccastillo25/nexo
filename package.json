{
  "name": "nexo",
  "private": true,
  "version": "0.0.0",
  "description": "Nexo — panel unico y suite de modulos internos de Materiales J Castillo (estilo Odoo)",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev",
    "build": "node scripts/check-app-tasks.mjs build && turbo run build",
    "lint": "node scripts/check-app-tasks.mjs lint && turbo run lint",
    "lint:plan": "node scripts/lint-apps.mjs plan",
    "lint:gate": "node scripts/lint-apps.mjs gate",
    "lint:deuda": "node scripts/lint-apps.mjs deuda",
    "lint:self-test": "node scripts/lint-apps.mjs self-test",
    "typecheck": "node scripts/check-app-tasks.mjs typecheck && turbo run typecheck",
    "test:agencia:access": "node apps/agencia/scripts/check-access.cjs",
    "test:rrhh:p1": "node supabase/tests/run_rrhh_p1_pin_ambiguo.mjs",
    "test:db": "pnpm run test:rrhh:p1 && pnpm run test:rrhh:compartido && pnpm run test:rrhh:p2 && pnpm run test:rrhh:p3 && pnpm run test:rrhh:p4",
    "verify": "pnpm run typecheck && pnpm run lint:gate && pnpm run lint:self-test && pnpm run test:db && pnpm run test:agencia:access && pnpm run build",
    "test:rrhh:compartido": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261015181000_p1_pin_ambiguo_fallo_cerrado.sql supabase/tests/rrhh_p1_pin_ambiguo.prueba.sql",
    "test:rrhh:p2": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261015181000_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261016231000_rrhh_p2_pin_unico_empresa.sql supabase/tests/rrhh_p2_pin_unico.prueba.sql",
    "test:rrhh:p3": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261015181000_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261016231000_rrhh_p2_pin_unico_empresa.sql supabase/migrations/20261016232000_rrhh_p3_marca_contrato.sql supabase/tests/rrhh_p3_contrato.prueba.sql",
    "test:rrhh:p4": "node supabase/tests/run_rrhh_pglite.mjs supabase/tests/rrhh_kiosco_entorno.sql supabase/migrations/20261015181000_p1_pin_ambiguo_fallo_cerrado.sql supabase/migrations/20261016231000_rrhh_p2_pin_unico_empresa.sql supabase/migrations/20261016232000_rrhh_p3_marca_contrato.sql supabase/migrations/20261016233000_rrhh_p4a_kiosko_solicitudes.sql supabase/migrations/20261016234000_rrhh_p4b_marca_atomica_idempotente.sql supabase/tests/rrhh_p4_secuencia_idempotencia.prueba.sql"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "turbo": "^2.1.0"
  }
}
