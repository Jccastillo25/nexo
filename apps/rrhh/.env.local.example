# Proyecto unificado nexo-core (ver docs/DATABASE.md) — mismo proyecto que
# apps/crm, NO el Supabase original de RRHH (ese quedo huerfano tras el
# borron-y-cuenta-nueva del 2026-09-02, ver git log de apps/rrhh).
NEXT_PUBLIC_SUPABASE_URL=https://yrbjlmiqhkyxtlcerowh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3hLYjOkXzwquHu6JTHND0A_S8ViHAAJ

# Fase 4 (2026-09-16, bloque pre-F1.5): Storage privado de documentos del
# expediente (bucket rrhh-documentos-privados). Necesaria para crear/leer
# URLs firmadas (createSignedUploadUrl/createSignedUrl) desde
# @nexo/supabase/admin — sin esta variable, subir/descargar un
# documento falla con un error explícito (no un 500 generico), ver ese
# archivo. Las Environment Variables de Vercel NO se comparten entre
# proyectos aunque sean del mismo monorepo/dominio (CLAUDE.md) — hay que
# configurarla en el proyecto de Vercel de RRHH especificamente, aunque ya
# exista en el de Nexo. Tomar el valor de Settings -> API -> service_role
# del proyecto nexo-core en Supabase (secreto, nunca commitear el valor
# real).
# SUPABASE_SERVICE_ROLE_KEY=

# id de 'materiales-jcastillo' en core.companies (single-tenant por ahora,
# lo lee getCompanyId() de @nexo/auth) — mismo id en todas las apps.
NEXO_COMPANY_ID=2b8525bd-a01a-4b55-a32c-ffe70761d96d

# IMPORTANTE — paso manual pendiente en el dashboard de Supabase:
# Settings -> API -> Data API -> Exposed schemas -> agregar "rrhh"
# (ademas de "public"/"crm", que ya vienen expuestos). Sin esto, toda
# query directa a rrhh.empleados/rrhh.parametros_ley/etc. desde este
# cliente falla con 404/"schema not found" — los RPCs de public
# (validar_acceso_operativo, registrar_marca_terminal, crear_empleado)
# funcionan igual sin este paso, viven en public.

# Override solo para dev local (puertos distintos) o acceso directo al
# deployment *.vercel.app de este modulo — en produccion no hace falta,
# Multi-Zones sirve todo bajo el mismo dominio publico (ver
# getPanelUrl y updateSession de @nexo/auth y @nexo/supabase).
# NEXO_PANEL_URL=http://localhost:3000

# Kiosco (/kiosco): no necesita variable de entorno. Cada equipo se enrola
# con un codigo de un solo uso generado en Asistencia -> Configuracion ->
# Dispositivos; el token queda en una cookie httpOnly del navegador del
# kiosco. La variable del dispositivo fijo por deployment se retiro el
# 2026-10-20 (N7/H5 de la revision integral).
