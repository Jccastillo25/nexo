NEXT_PUBLIC_SUPABASE_URL=https://yrbjlmiqhkyxtlcerowh.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_3hLYjOkXzwquHu6JTHND0A_S8ViHAAJ

# Service role secret (Supabase -> Settings -> API). Solo se usa server-side
# (createServiceRoleClient de @nexo/supabase/admin) para subir el logo/imagen
# de fondo del login a Storage (bucket "platform-assets") desde
# Configuración → Marca, y para crear, bloquear o cambiar la contraseña de
# cuentas en Configuración → Usuarios. NUNCA exponer con NEXT_PUBLIC_, nunca
# commitear el valor real.
SUPABASE_SERVICE_ROLE_KEY=

# id de 'materiales-jcastillo' en core.companies (single-tenant por ahora,
# ver getCompanyId en packages/auth/empresa.ts) — mismo valor en todas las apps.
NEXO_COMPANY_ID=2b8525bd-a01a-4b55-a32c-ffe70761d96d

# URL del deploy real de la zona /rrhh (Multi-Zones). En local, el puerto de
# `pnpm --filter rrhh dev:zone`
# (3002, ver apps/rrhh/package.json). En produccion, la URL del proyecto
# Vercel de apps/rrhh (hoy: nexo-rrhh).
RRHH_APP_URL=http://localhost:3002

# Zona /presupuesto (docs/plan/19-presupuesto.md): puerto de
# `pnpm --filter nexo-presupuesto dev:zone`. En produccion, la URL del
# proyecto Vercel que era del CRM. Sin esta variable no hay rewrite.
PRESUPUESTO_APP_URL=http://localhost:3001

# Zona /flotilla (docs/plan/22-flotilla-entregas.md): puerto de
# `pnpm --filter nexo-flotilla dev:zone`. Sin esta variable no hay rewrite.
FLOTILLA_APP_URL=http://localhost:3006
